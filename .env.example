# Copy this file's variable NAMES into Render's Environment Variables dashboard.
# NEVER put real values in a file that gets committed to GitHub.

# Postgres connection string. Render provides this automatically when you
# create a PostgreSQL database on Render and add it to this web service
# (it will offer an "Internal Database URL" - use that one).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@host:5432/dbname

# Your sickw.com API key. Paste your real key only inside Render's dashboard,
# never in this file, never in any file you commit.
SICKW_API_KEY=PASTE-YOUR-REAL-SICKW-API-KEY-HERE

# Used ONCE on first boot to auto-create the admin account if it doesn't
# exist yet. Set these in Render, log in once, then you can leave them
# (they only affect first-boot creation, not future logins).
ADMIN_EMAIL=admin@unlockwithus.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# A random long random string used to secure PHP sessions.
APP_SECRET=change-this-to-a-long-random-string
